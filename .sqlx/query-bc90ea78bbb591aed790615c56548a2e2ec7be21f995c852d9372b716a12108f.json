  "db_name": "PostgreSQL",
  "query": "SELECT a.id, a.template_id, a.title, a.section, a.position, a.kind, a.expense_group_id, a.expense_group_name, a.category_id, a.subcategory_id, a.category_name, a.subcategory_name, a.amount, a.notes, a.source, a.completed_at, a.source_key, m.month FROM payday_allocations a JOIN payday_months m ON m.household_id=a.household_id AND m.id=a.month_id WHERE a.household_id=$1 AND a.deleted_at IS NULL AND m.month >= $2 AND m.month < $3 ORDER BY m.month DESC, a.completed_at DESC NULLS LAST, a.id",
