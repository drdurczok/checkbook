# Public example only. Replace every placeholder using protected CI variables.
# Never commit a populated copy; use independent strong database passwords.
APP_ENV=production
DATABASE_URL=postgresql://checkbook_admin:${DB_PASSWORD}@postgres:5432/checkbook
APP_DATABASE_URL=postgresql://checkbook_app:${DB_APP_PASSWORD}@postgres:5432/checkbook
ALLOWED_ORIGINS=https://your-domain.example
GOOGLE_CLIENT_ID=
TUNNEL_TOKEN=
SESSION_HOURS=24
DEV_AUTH_ENABLED=false
DEV_AUTH_LISTEN_ADDRESS=
MAINTENANCE_INTERVAL_SECONDS=900
BACKUP_HOST_PATH=/srv/checkbook/backups
DB_PASSWORD=change-me
DB_APP_PASSWORD=change-me
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://example.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=change-me
ADMIN_SERVICE_TOKEN=

# GitLab deploy target.
DEPLOY_HOST=192.0.2.20
DEPLOY_USER=deploy
DEPLOY_SSH_KEY=
# Pinned known_hosts entry for DEPLOY_HOST. For a non-default port, use the
# `[host]:port ssh-ed25519 ...` form. Store the real value as a protected CI variable.
DEPLOY_KNOWN_HOSTS=
DEPLOY_PATH=/opt/checkbook/prod
DEPLOY_PORT=22

# Use a TLS-enabled container registry. An isolated HTTP registry requires an
# explicit host-only bootstrap opt-in; never use production credentials over HTTP.
DOCKER_INSECURE_REGISTRY=

# Optional CT-local frontend debug port.
FRONTEND_HOST_PORT=13010
